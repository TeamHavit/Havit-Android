<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.home.community.CommunityFragment">

    <TextView
        android:id="@+id/tv_community_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="19dp"
        android:text="함께 콘텐츠를 나눠보세요!"
        android:textAppearance="@style/Text16Semibold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_create_community_contents"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_margin="12dp"
        android:padding="5dp"
        android:src="@drawable/ic_edit_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/hsv_community_chip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_community_title">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_community_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/ch_all"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:text="@string/category_entire"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_travel"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여행/맛집"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_job"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="직장/자기계발"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_life"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="라이프"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_knowledge"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시사/지식"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_hobby"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="취미/건강"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/ch_entertainment"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="17dp"
                android:text="엔터테인먼트"
                android:textAppearance="@style/Text12Semibold"
                android:textColor="@color/selector_chip_text"
                app:chipBackgroundColor="@color/selector_chip"
                app:chipMinTouchTargetSize="0dp"
                app:textEndPadding="10dp"
                app:textStartPadding="10dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <View
        android:id="@+id/view_community_chip"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/gray_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_community_chip" />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_community_chip"
        tools:listitem="@layout/item_community" />
</androidx.constraintlayout.widget.ConstraintLayout>
